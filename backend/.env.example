# Copy to .env (never commit .env). On a host (Render / Cloud Run / Fly) set these as environment variables.

# ---- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...        # Claude: the replies and corrections
OPENAI_API_KEY=sk-...               # Whisper (speech-to-text) + OpenAI TTS

# ---- Protect your wallet (strongly recommended) ----------------------------
# If set, the app must send the header  x-app-key: <this value>  (see README, section "Lock the endpoint").
APP_API_KEY=
RATE_LIMIT_PER_MINUTE=40            # per IP

# ---- Models ----------------------------------------------------------------
# Only if the API says the key "is not scoped to a workspace": the workspace id (wrkspc_...) from the Anthropic Console.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-5-5    # cheap and fast; use claude-sonnet-5-5 for better corrections
WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Voices ----------------------------------------------------------------
DEFAULT_TTS_PROVIDER=openai         # used when the app does not send tts_provider
# OpenAI voice per persona (lesson tones map to: polite->polite_sensei, friendly->casual_friend, tsundere->tsundere)
OPENAI_VOICE_POLITE_SENSEI=sage
OPENAI_VOICE_CASUAL_FRIEND=coral
OPENAI_VOICE_TSUNDERE=shimmer
OPENAI_VOICE_KANSAI=ash
# ElevenLabs (optional). One default voice, or one per persona.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_POLITE_SENSEI=
ELEVENLABS_VOICE_CASUAL_FRIEND=
ELEVENLABS_VOICE_TSUNDERE=
ELEVENLABS_VOICE_KANSAI=

# ---- Audio delivery --------------------------------------------------------
# url    = the reply voice is served at GET /v1/audio/<id>.mp3 for 15 minutes (small JSON, recommended)
# base64 = the mp3 is embedded in audio_url as a data: URL (stateless, but bigger responses)
AUDIO_DELIVERY=url
PUBLIC_BASE_URL=                    # e.g. https://japanese-api.onrender.com  (leave empty to detect from the request)
AUDIO_TTL_MINUTES=15

# ---- Server ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
SESSION_TTL_MINUTES=120             # how long a conversation is remembered
MAX_HISTORY_MESSAGES=24
MAX_AUDIO_BYTES=5242880
ANTHROPIC_MAX_TOKENS=700

# ---- Only for generate_episodes_media.js ------------------------------------
# MEDIA_TTS_PROVIDER=openai
# EPISODES_DIR=../japanese_app/assets/data/episodes
# AUDIO_OUT_DIR=../japanese_app/assets/audio
# ELEVENLABS_VOICES_MALE=id1,id2,id3      # first one = the learner (サーレム)
# ELEVENLABS_VOICES_FEMALE=id1,id2,id3
